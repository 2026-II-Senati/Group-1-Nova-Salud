    {
      "name": "04. POST /api/productos (crear valido) - 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"productoId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "let cuerpo = {};",
              "try { cuerpo = pm.response.json(); } catch (e) {}",
              "pm.test(\"Devuelve el id del producto creado\", function () {",
              "  pm.expect(cuerpo.id).to.be.a(\"number\");",
              "});",
              "if (cuerpo && cuerpo.id) { pm.collectionVariables.set(\"productoId\", cuerpo.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"ZZ Prueba T28\",\n  \"precio\": 5.5,\n  \"stock\": 10,\n  \"stock_minimo\": 5,\n  \"categoria_id\": 1,\n  \"proveedor_id\": 1\n}",
          "options": {
